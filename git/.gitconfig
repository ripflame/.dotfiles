[alias]
  co = checkout
  ca = commit -am
  s = status
  hist = log --pretty=format:\"%C(yellow)%h%C(reset) %C(green)(%cd)%C(reset) %C(auto)%d%C(reset) %s\" --graph --date=human
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	autocrlf = input
  pager = delta
[push]
	default = simple
[init]
	defaultBranch = main
[pull]
	rebase = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true
[merge]
	conflictstyle = diff3
[diff]
    colorMoved = default
[include]
	path = ~/.gitconfig.local
